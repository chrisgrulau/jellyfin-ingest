<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.Ingest</RootNamespace>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <FileVersion>0.6.0.0</FileVersion>
    <!-- The shared source is compiled in whole but Ingest uses only part of it (the AI entry point client); its own
         .editorconfig stops per-folder rules, so the "internal class never instantiated" check is off for this project -->
    <NoWarn>$(NoWarn);CA1812</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dashboard API controller -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provided by the Jellyfin server at runtime: compile against them, don't ship them -->
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Shared source (resilience, the AI plugin's entry point …), compiled in as internal code; see external/common -->
  <Import Project="../../external/common/Common.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Ingest.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
